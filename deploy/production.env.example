DJANGO_SETTINGS_MODULE=config.production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-random-private-secret
DJANGO_ALLOWED_HOSTS=library.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://library.example.org
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=3600
LIBRARY_DOMAIN=library.example.org
LIBRARY_TLS_EMAIL=operator@example.org
LIBRARY_STATIC_ROOT=D:/Library-Manager/web/staticfiles
LIBRARY_APP_DATABASE_URL=replace-with-private-pooled-url
LIBRARY_MIGRATOR_DATABASE_URL=replace-with-private-direct-url
EMAIL_HOST=replace-with-smtp-host
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-private-smtp-user
EMAIL_HOST_PASSWORD=replace-with-private-smtp-password
DEFAULT_FROM_EMAIL=library@example.org
